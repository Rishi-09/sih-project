# Copy to .env and fill in. The server runs fine with none of this set —
# it falls back to SQLite defaults and offline canned AI advisories.

# TiDB Cloud (MySQL-compatible). Copy the exact connection string from
# TiDB Cloud's Connect panel. It must include sslaccept=strict.
# Do not commit the real value.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"

PORT=4000

# Optional. Without this, the AI advisory/chat routes serve the pre-written
# knowledge-base fallback instead of calling the API — see src/ai/fallback
# logic in src/ai/client.ts. Free tier key: https://console.groq.com/keys
GROQ_API_KEY=

# Confirmed current production model on Groq as of 2026-08-30 (console.groq.com/docs/models).
# Swap to openai/gpt-oss-120b or llama-3.1-8b-instant if you want a different
# quality/latency tradeoff — that's your call, not a default we picked for you.
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed CORS origins for the Next.js dev server.
CORS_ORIGIN=http://localhost:3000

# Optional ML microservice endpoint (pinged every 14 min to keep free hosts awake)
# Examples:
#   Railway internal: http://r2-ml.railway.internal:8000
#   Render free tier: https://r2-ml.onrender.com
ML_API_URL=
# Backward-compatible alias:
# HF_ML_URL=

# WebSocket endpoint for the dedicated Retribution simulator (retribution/run_ws_only.py).
# This is the real physics + ML backend; when unset it now defaults to the deployed
# Railway instance (see src/twin/opsClient.ts) so the stub twin fallback in
# runManager.ts is rarely hit. Override for local dev against a locally-run simulator:
# OPS_WS_URL=ws://localhost:8766
OPS_WS_URL=

