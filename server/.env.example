# Copy to .env and fill in. The server runs fine with none of this set —
# it falls back to SQLite defaults and offline canned AI advisories.

# SQLite for dev (default if unset). Point at a Postgres URL for deploy.
DATABASE_URL="file:./dev.db"

PORT=4000

# Optional. Without this, the AI advisory/chat routes serve the pre-written
# knowledge-base fallback instead of calling the API — see src/ai/fallback
# logic in src/ai/client.ts. Free tier key: https://console.groq.com/keys
GROQ_API_KEY=

# Confirmed current production model on Groq as of 2026-08-30 (console.groq.com/docs/models).
# Swap to openai/gpt-oss-120b or llama-3.1-8b-instant if you want a different
# quality/latency tradeoff — that's your call, not a default we picked for you.
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed CORS origins for the Next.js dev server.
CORS_ORIGIN=http://localhost:3000
