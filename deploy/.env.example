# Self-Hosted Environment Variables
# Copy this to .env in the project root before running docker compose up.

# ── Required ────────────────────────────────────────────────────────────────
# None! The stack runs out of the box with SQLite and offline AI fallbacks.

# ── Optional: AI Advisory (Groq LLM) ───────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional: ML Microservice ──────────────────────────────────────────────
# If you're running the ML service separately (e.g. on Railway free tier):
ML_API_URL=

# ── Optional: Phone Lock-Screen Push Notifications (ntfy.sh) ───────────────
# Zero-config push notifications directly to phone lock screens (iOS/Android)
# even when locked, screen off, or in pocket.
# Free, open source, no accounts needed. Open https://ntfy.sh/<topic> on your phone.
NTFY_TOPIC=sih-twin-alerts

# ── Optional: Alert Webhooks (Discord, Slack, Telegram) ───────────────────
# Sent alongside ntfy when engine alerts or server events fire.
ALERT_WEBHOOK_URL=


# ── Optional: Host port ────────────────────────────────────────────────────
# Change if port 80 is already taken on the host machine.
HOST_PORT=80
